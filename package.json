{
  "name": "orbit",
  "version": "0.0.0",
  "private": true,
  "description": "Orbit - a local-first, event-sourced AI agent workbench",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.0",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
